pipeline {
  agent any
  environment {
    REGISTRY = 'registry.example.com/payment'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') { steps { dir('backend') { sh 'mvn -B -DskipTests clean package' } } }
    stage('Run Tests') { steps { dir('backend') { sh 'mvn test' } } }
    stage('SonarQube Analysis') { steps { echo 'SonarQube analysis placeholder: mvn sonar:sonar' } }
    stage('Build Docker Images') { steps { sh 'docker compose -f docker/docker-compose.yml build' } }
    stage('Push Docker Images') { steps { echo 'Push images placeholder' } }
    stage('Deploy') { steps { echo 'Deploy to AWS ECS/EKS placeholder' } }
  }
}
